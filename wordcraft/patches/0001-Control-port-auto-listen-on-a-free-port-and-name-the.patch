+    #[test]
+    fn auto_or_a_port_number() {
+        assert_eq!(parse_port("7981"), Some(7981));
+        assert_eq!(parse_port(" 7981\n"), Some(7981));
+        for auto in ["auto", "AUTO", "Auto", " auto ", "0"] {
+            assert_eq!(parse_port(auto), Some(AUTO), "{auto:?}");
+        }
+        for junk in ["", "automatic", "-1", "65536", "7981x", "0x1f"] {
+            assert_eq!(parse_port(junk), None, "{junk:?}");
+        }
+    }
+
+    /// `auto` binds a free port, and the key file is named after that port, so a client lists
+    /// the key files to find the windows and the port to connect to.
+    #[test]
+    fn auto_names_the_key_file_after_the_port_it_got() {
+        let dir = temp_dir("auto");
+        let (rx, key_file) = start(AUTO, egui::Context::default(), Some(&dir)).unwrap();
+        let key_file = key_file.unwrap();
+        if wordcraft_control_key::instance_id().is_none() {
+            let name = key_file.path().file_name().unwrap().to_str().unwrap();
+            let port: u16 = name.strip_prefix("control-key.local-").unwrap().parse().unwrap();
+            assert_ne!(port, AUTO, "the real port, not 0");
+            assert_eq!(key_file.path(), wordcraft_control_key::key_path(&dir, port));
+            let key = std::fs::read_to_string(key_file.path()).unwrap();
+            let mut c = Conn::open(port);
+            c.send(&format!(r#"{{"id":1,"key":"{key}","method":"document.inspect"}}"#));
+            answer(&rx);
+            assert_eq!(c.recv()["ok"], true);
+        }
+        // Two windows started with `auto` get two ports and two key files.
+        let (_rx2, other) = start(AUTO, egui::Context::default(), Some(&dir)).unwrap();
+        let other = other.unwrap();
+        if wordcraft_control_key::instance_id().is_none() {
+            assert_ne!(other.path(), key_file.path());
+        }
+        key_file.remove();
+        other.remove();
+        let _ = std::fs::remove_dir_all(&dir);
+    }
