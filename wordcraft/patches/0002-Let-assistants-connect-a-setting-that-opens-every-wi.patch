+    /// File › Options › Agents: letting assistants connect is a UI command, kept between runs,
+    /// and off unless the user turned it on.
+    #[test]
+    fn allow_assistants_is_a_ui_command_and_survives_a_restart() {
+        let mut a = app();
+        assert_eq!(a.run("ui.allowAssistants", json!({})).unwrap(), json!({"allowAssistants": false}), "off by default; no value reads it");
+        assert_eq!(a.run("ui.allowAssistants", json!({"value": true})).unwrap(), json!({"allowAssistants": true}));
+        for junk in [json!({"value": "yes"}), json!({"value": 0}), json!({"value": null}), json!({"value": [false]})] {
+            assert!(a.run("ui.allowAssistants", junk).is_err());
+        }
+        assert!(a.ui.allow_assistants, "a rejected value keeps the setting");
+        let saved = serde_json::to_string(&a.prefs()).unwrap();
+        assert!(saved.contains(r#""allowAssistants":true"#), "{saved}");
+        let mut b = app();
+        b.apply_prefs(UiState::from_json(saved.as_bytes()).unwrap());
+        assert!(b.ui.allow_assistants);
+        // Settings saved before the option existed, or holding junk for it, leave it off.
+        for old in [r#"{"tab":"Insert"}"#, r#"{"tab":"Insert","allowAssistants":"yes"}"#] {
+            let old = UiState::from_json(old.as_bytes()).unwrap();
+            assert!(!old.allow_assistants && old.tab == "Insert");
+        }
+        // It works with no document open, like the other settings.
+        assert!(works_without_document("ui.allowAssistants"));
+    }
