+/// Start the control server on `port` ([`control_server::AUTO`]: a free one) and hand its
+/// requests to the app; its key file goes in `key_file`. Whether it started.
+fn open_control(app: &mut WordApp, port: u16, ctx: &egui::Context, key_file: &mut Option<control_server::KeyFile>) -> bool {
+    let Some((rx, file)) = control_server::start(port, ctx.clone(), wordcraft_control_key::settings_dir().as_deref()) else { return false };
+    app.set_control(rx);
+    *key_file = file;
+    true
+}
