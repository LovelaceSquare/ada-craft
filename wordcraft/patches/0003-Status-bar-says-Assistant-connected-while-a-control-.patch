+/// While an assistant is connected to the window's control channel (an authorised connection is
+/// open), the status bar says so, in the accent colour, so the user always knows.
+fn assistant_connected(app: &WordApp, ui: &mut Ui) {
+    if !app.assistant_connected() {
+        return;
+    }
+    let t = Tokens::get(ui.ctx());
+    let s = tl!("Assistant connected");
+    let font = TypeRung::Caption.regular();
+    let track = TypeRung::Caption.tracking();
+    let w = text_width(ui.painter(), s, &font, track, t.accent_text);
+    let (r, resp) = ui.allocate_exact_size(vec2(w + 1.0, TypeRung::Caption.line_height()), Sense::hover());
+    paint_text(ui.painter(), r.min, Align2::LEFT_TOP, s, &font, track, t.accent_text);
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Label, true, s));
+    resp.on_hover_text(tl!("An assistant is connected to this window through its control channel and can read and edit the document."));
+}
