+    /// While the control server counts an authorised connection, the status bar says an
+    /// assistant is connected, and stops saying so when it closes.
+    #[test]
+    fn the_status_bar_shows_a_connected_assistant() {
+        use egui_kittest::kittest::Queryable;
+        let app = SlideApp::new(Session::with_new(), Services::default());
+        let clients = app.control_clients.clone();
+        let mut harness = egui_kittest::Harness::builder().with_size(egui::vec2(1200.0, 800.0)).build_ui_state(
+            |ui, app: &mut SlideApp| {
+                app.logic(ui.ctx());
+                app.ui(ui);
+            },
+            app,
+        );
+        harness.run_steps(2);
+        assert!(harness.query_by_label("Assistant connected").is_none(), "nobody connected");
+        clients.store(1, std::sync::atomic::Ordering::Relaxed);
+        harness.run_steps(2);
+        assert!(harness.state().assistant_connected());
+        assert!(harness.query_by_label("Assistant connected").is_some());
+        clients.store(0, std::sync::atomic::Ordering::Relaxed);
+        harness.run_steps(2);
+        assert!(harness.query_by_label("Assistant connected").is_none(), "gone when the connection closes");
+    }
