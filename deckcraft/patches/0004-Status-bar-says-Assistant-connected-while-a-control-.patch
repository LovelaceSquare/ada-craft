+/// An authorised connection, counted in the window's clients until it closes; the window
+/// repaints when the count changes (the status bar shows it).
+struct Connected(Arc<AtomicUsize>, egui::Context);
+
+impl Connected {
+    fn new(clients: &Arc<AtomicUsize>, ctx: &egui::Context) -> Self {
+        clients.fetch_add(1, Ordering::Relaxed);
+        ctx.request_repaint();
+        Self(clients.clone(), ctx.clone())
+    }
+}
+
+impl Drop for Connected {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::Relaxed);
+        self.1.request_repaint();
+    }
+}
