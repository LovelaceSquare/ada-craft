+    /// A connection counts as a client from its first authorised request until it closes;
+    /// refused ones never count.
+    #[test]
+    fn authorised_connections_are_counted_while_open() {
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let clients = Arc::new(AtomicUsize::new(0));
+        let _rx = serve_on(listener, egui::Context::default(), KEY.to_string(), FIRST_REQUEST, clients.clone());
+        // The count changes on the connection's thread: wait for it a little.
+        let settle = |want: usize| {
+            let t0 = Instant::now();
+            while clients.load(Ordering::Relaxed) != want && t0.elapsed() < Duration::from_secs(5) {
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            clients.load(Ordering::Relaxed)
+        };
+        let mut refused = Conn::open(port);
+        assert_eq!(refused.call(r#"{"id":1,"method":"auth","key":"nope"}"#)["error"], "unauthorized");
+        assert!(refused.closed());
+        assert_eq!(settle(0), 0, "a refused connection is not a client");
+        let mut a = Conn::open(port);
+        let quiet = Conn::open(port);
+        assert_eq!(a.call(&format!(r#"{{"id":1,"method":"auth","key":"{KEY}"}}"#))["ok"], true);
+        assert_eq!(settle(1), 1, "only the authorised one counts");
+        let mut b = Conn::open(port);
+        assert_eq!(b.call(&format!(r#"{{"id":1,"method":"auth","key":"{KEY}"}}"#))["ok"], true);
+        assert_eq!(settle(2), 2);
+        drop(a);
+        assert_eq!(settle(1), 1, "a closed connection stops counting");
+        drop((b, quiet));
+        assert_eq!(settle(0), 0);
+    }
+
