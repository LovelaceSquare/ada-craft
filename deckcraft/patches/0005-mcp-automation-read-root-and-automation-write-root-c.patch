+//! Reading and writing the files a command names by path.
+//!
+//! Every such read and write goes through [`read_file`], [`write_file`] and [`file_len`], so the
+//! automation roots ([`crate::file_access`]) are checked in one place. Engine code that called
+//! `std::fs` itself would bypass them; a test in `file_access` keeps that from happening.
+
+/// The bytes of the file at `path`, inside the automation read root when one is in force.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn read_file(path: &str) -> Result<Vec<u8>, String> {
+    crate::file_access::check_read(path)?;
+    std::fs::read(path).map_err(|e| format!("{path}: {e}"))
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn read_file(path: &str) -> Result<Vec<u8>, String> {
+    Err(format!("{path}: files are opened through the browser on the web"))
+}
+
+/// Write `bytes` to the file at `path`, inside the automation write root when one is in force.
+///
+/// The bytes go to a temporary sibling first and are renamed over `path`, so a failed save never
+/// truncates the old file. The sibling is in the same folder, so it is inside the root whenever
+/// `path` is.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn write_file(path: &str, bytes: &[u8]) -> Result<(), String> {
+    crate::file_access::check_write(path)?;
+    let tmp = format!("{path}.saving");
+    std::fs::write(&tmp, bytes).map_err(|e| format!("{path}: {e}"))?;
+    std::fs::rename(&tmp, path).map_err(|e| format!("{path}: {e}"))
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn write_file(_path: &str, _bytes: &[u8]) -> Result<(), String> {
+    Err("saving to a path is not available in the browser".into())
+}
+
+/// The size in bytes of the file at `path`; `None` when it can't be read, or lies outside the
+/// automation read root (File › Info doesn't reveal files the agent may not read).
+#[cfg(not(target_arch = "wasm32"))]
+pub fn file_len(path: &str) -> Option<u64> {
+    crate::file_access::check_read(path).ok()?;
+    std::fs::metadata(path).ok().map(|m| m.len())
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn file_len(_path: &str) -> Option<u64> {
+    None
+}
