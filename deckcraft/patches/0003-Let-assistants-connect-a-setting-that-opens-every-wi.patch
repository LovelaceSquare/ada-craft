     use super::*;
 
+    /// Preferences › Assistants: letting assistants connect is off at first, a UI command
+    /// (`{on}` sets it, no value toggles it) and a `ui.set` key, and is kept with the UI state.
+    #[test]
+    fn allow_assistants_is_a_ui_command_and_survives_a_restart() {
+        let mut a = SlideApp::new(Session::with_new(), Services::default());
+        assert!(!a.ui.allow_assistants, "off by default");
+        assert_eq!(a.run("app.allowAssistants", json!({"on": true})).unwrap(), json!({"allowAssistants": true}));
+        assert_eq!(a.run("app.allowAssistants", json!({"on": true})).unwrap(), json!({"allowAssistants": true}));
+        assert_eq!(a.run("app.allowAssistants", json!({})).unwrap(), json!({"allowAssistants": false}), "no value toggles");
+        let ctx = egui::Context::default();
+        let (req, _rx) = ControlRequest::new("ui.set", json!({"allowAssistants": true}));
+        let r = match control::handle(&mut a, &ctx, &req) {
+            control::Outcome::Done(r) => r,
+            control::Outcome::Screenshot { .. } => Value::Null,
+        };
+        assert_eq!(r["result"]["allowAssistants"], true);
+        let saved = serde_json::to_string(&a.ui).unwrap();
+        assert!(saved.contains(r#""allowAssistants":true"#), "{saved}");
+        let back: UiState = serde_json::from_str(&saved).unwrap();
+        assert!(back.allow_assistants);
+        let old: UiState = serde_json::from_str(r#"{"tab":"Insert"}"#).unwrap();
+        assert!(!old.allow_assistants && old.tab == "Insert", "settings from before the option leave it off");
+    }
+
+    /// Preferences › Assistants: the checkbox turns it on and off.
+    #[test]
+    fn preferences_checkbox_lets_assistants_connect() {
+        use egui_kittest::kittest::Queryable;
+        let mut harness = egui_kittest::Harness::builder().with_size(egui::vec2(1200.0, 800.0)).build_ui_state(
+            |ui, app: &mut SlideApp| {
+                app.logic(ui.ctx());
+                app.ui(ui);
+            },
+            SlideApp::new(Session::with_new(), Services::default()),
+        );
+        harness.state_mut().run("app.preferences", json!({})).unwrap();
+        harness.run_steps(2);
+        harness.get_by_label("Let assistants connect to this window").click();
+        harness.run_steps(2);
+        assert!(harness.state().ui.allow_assistants, "the checkbox turns it on");
+        harness.get_by_label("Let assistants connect to this window").click();
+        harness.run_steps(2);
+        assert!(!harness.state().ui.allow_assistants, "and off again");
+    }
