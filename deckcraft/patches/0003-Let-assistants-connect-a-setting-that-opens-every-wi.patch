-/// The app and the control server's key file (removed on exit).
-struct App(SlideApp, Option<control_server::KeyFile>);
+/// The app, the control server's key file (removed on exit) and the control channel's state.
+struct App(SlideApp, Option<control_server::KeyFile>, Control);
+
+/// Whether the window's control channel is open, and Preferences › Assistants › Let assistants
