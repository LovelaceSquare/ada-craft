         self.0.raw_input_hook(raw);
@@ -50,6 +67,15 @@ fn config_dir() -> Option<std::path::PathBuf> {
     deckcraft_control_key::settings_dir()
 }
 
+/// Start the control server on `port` ([`control_server::AUTO`]: a free one) and hand its
+/// requests to the app; its key file goes in `key_file`. Whether it started.
+fn open_control(app: &mut SlideApp, port: u16, ctx: &egui::Context, key_file: &mut Option<control_server::KeyFile>) -> bool {
+    let Some((rx, file)) = control_server::start(port, ctx.clone(), config_dir().as_deref()) else { return false };
+    app.control_rx = Some(rx);
+    *key_file = file;
+    true
+}
+
 fn prefs_path() -> Option<std::path::PathBuf> {
     config_dir().map(|b| b.join("ui.json"))
 }
@@ -208,12 +234,13 @@ fn main() -> eframe::Result {
             }
             app.integrated_titlebar = cfg!(target_os = "macos");
             let mut key_file = None;
-            if let Some(port) = control_port
-                && let Some((rx, file)) = control_server::start(port, cc.egui_ctx.clone(), config_dir().as_deref())
-            {
-                app = app.with_control(rx);
-                key_file = file;
-            }
+            // With Let assistants connect on (Preferences › Assistants), a window started without a
+            // control port opens one anyway, on a free port: `--control auto`.
+            let port = control_port.or_else(|| app.ui.allow_assistants.then_some(control_server::AUTO));
+            let control = Control {
+                open: port.is_some_and(|port| open_control(&mut app, port, &cc.egui_ctx, &mut key_file)),
+                allow_assistants: app.ui.allow_assistants,
+            };
             if sample && let Err(e) = deckcraft_engine::sample::open_sample(&mut app.session) {
                 log::error!("sample: {e}");
             }
@@ -225,7 +252,7 @@ fn main() -> eframe::Result {
             if show {
