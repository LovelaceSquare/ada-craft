 impl eframe::App for App {
     fn logic(&mut self, ctx: &egui::Context, _frame: &mut eframe::Frame) {
         self.0.logic(ctx);
+        // Let assistants connect, changed in Preferences or by `app.allowAssistants`: saved at
+        // once, so windows opened from now on follow it, and turned on, it opens this window's
+        // control channel on a free port. Turned off, an open channel stays until the window closes.
+        if self.0.ui.allow_assistants != self.2.allow_assistants {
+            self.2.allow_assistants = self.0.ui.allow_assistants;
+            save_prefs(&self.0);
+            if self.2.allow_assistants && !self.2.open {
+                self.2.open = open_control(&mut self.0, control_server::AUTO, ctx, &mut self.1);
+            }
+        }
     }
