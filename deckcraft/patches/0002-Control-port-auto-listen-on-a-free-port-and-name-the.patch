+/// The port `auto` asks for: any free one.
+pub const AUTO: u16 = 0;
+
+/// A `--control` or `WORDCRAFT_CONTROL_PORT` value: a port number, or `auto` (any letter case)
+/// for a free port the system picks, which is also what `0` means. `None` for anything else.
+pub fn parse_port(s: &str) -> Option<u16> {
+    let s = s.trim();
+    if s.eq_ignore_ascii_case("auto") { Some(AUTO) } else { s.parse().ok() }
+}
