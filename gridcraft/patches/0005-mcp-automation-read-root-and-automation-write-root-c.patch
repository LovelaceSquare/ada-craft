+//! `gridcraft-cli mcp --automation-read-root <dir> --automation-write-root <dir>`: through the MCP
+//! protocol, workbooks, data and pictures load only from inside the read root and are saved and
+//! exported only inside the write root; paths that leave a root (`..`, another folder, a sibling
+//! with the same prefix) are refused, and nothing is written outside.
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use std::path::{Path, PathBuf};
+
+use gridcraft_engine::file_access::AutomationRoots;
+use gridcraft_mcp::{Headless, Server};
+use serde_json::{Value, json};
+
+/// A 1x1 PNG, so `insert.picture` has something real to read.
+const PNG: &[u8] = &[
+    0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01,
+    0x08, 0x06, 0x00, 0x00, 0x00, 0x1f, 0x15, 0xc4, 0x89, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x44, 0x41, 0x54, 0x78, 0x9c, 0x63, 0xf8, 0xcf, 0xc0, 0xf0,
+    0x1f, 0x00, 0x05, 0x00, 0x01, 0xff, 0x89, 0x99, 0x3d, 0x1d, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82,
+];
+
+/// A fresh folder holding `in` (the read root, with `people.csv` and `pic.png`), `out` (the write
+/// root), `outside` (with `secret.csv` and `pic.png`) and `in2`, and a server confined to `in` and
+/// `out` (either may be left out).
+fn confined(tag: &str, read: bool, write: bool) -> (Server, PathBuf) {
+    let base = std::env::temp_dir().join(format!("gc-mcp-roots-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&base);
+    for d in ["in", "out", "outside", "in2"] {
+        std::fs::create_dir_all(base.join(d)).unwrap();
+    }
+    std::fs::write(base.join("in/people.csv"), "Name\nAda\n").unwrap();
+    std::fs::write(base.join("in/pic.png"), PNG).unwrap();
+    std::fs::write(base.join("outside/secret.csv"), "TOP SECRET\n").unwrap();
+    std::fs::write(base.join("outside/pic.png"), PNG).unwrap();
+    std::fs::write(base.join("in2/c.csv"), "Sibling\n").unwrap();
+    let (in_dir, out_dir) = (base.join("in"), base.join("out"));
+    let roots = AutomationRoots::new(read.then_some(in_dir.as_path()), write.then_some(out_dir.as_path())).unwrap();
+    (Server::new(Box::new(Headless::new().with_automation_roots(roots))), base)
+}
+
+fn s(p: &Path) -> String {
+    p.to_string_lossy().into_owned()
+}
+
+/// `tools/call` -> (isError, the first text block).
+fn call(server: &mut Server, name: &str, args: Value) -> (bool, String) {
+    let line = json!({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": name, "arguments": args}}).to_string();
+    let reply: Value = serde_json::from_str(&server.handle_line(&line).unwrap()).unwrap();
+    let result = &reply["result"];
+    let text = result["content"].as_array().unwrap().iter().find_map(|c| c["text"].as_str()).unwrap_or_default().to_string();
+    (result["isError"] == true, text)
+}
+
+fn ok(server: &mut Server, name: &str, args: Value) -> String {
+    let (error, text) = call(server, name, args.clone());
+    assert!(!error, "{name} {args}: {text}");
+    text
+}
+
+fn refused(server: &mut Server, name: &str, args: Value, why: &str) {
+    let (error, text) = call(server, name, args.clone());
+    assert!(error && text.contains(why), "{name} {args} should be refused ({why}): {text}");
+}
+
+fn run(server: &mut Server, command: &str, params: Value) -> (bool, String) {
+    call(server, "execute_command", json!({"command": command, "params": params}))
+}
+
+#[test]
+fn workbooks_open_only_from_inside_the_read_root() {
+    let (mut server, base) = confined("open", true, true);
+    let sep = std::path::MAIN_SEPARATOR;
+    ok(&mut server, "open_workbook", json!({"path": s(&base.join("in/people.csv"))}));
+    assert!(ok(&mut server, "get_cell", json!({"cell": "A2"})).contains("Ada"));
+
+    refused(&mut server, "open_workbook", json!({"path": s(&base.join("outside/secret.csv"))}), "outside the read root");
+    let up = format!("{}{sep}..{sep}outside{sep}secret.csv", s(&base.join("in")));
+    refused(&mut server, "open_workbook", json!({"path": up}), "outside the read root");
+    refused(&mut server, "open_workbook", json!({"path": s(&base.join("in2/c.csv"))}), "outside the read root");
+    // Data and pictures read by path are checked too.
+    let (error, text) = run(&mut server, "data.getData", json!({"path": s(&base.join("outside/secret.csv"))}));
+    assert!(error && text.contains("outside the read root"), "{text}");
+    let (error, text) = run(&mut server, "insert.picture", json!({"path": s(&base.join("outside/pic.png"))}));
+    assert!(error && text.contains("outside the read root"), "{text}");
+    let (error, text) = run(&mut server, "insert.picture", json!({"path": s(&base.join("in/pic.png"))}));
+    assert!(!error, "a picture inside the read root: {text}");
+    let _ = std::fs::remove_dir_all(base);
+}
+
+#[test]
+fn files_are_written_only_inside_the_write_root() {
+    let (mut server, base) = confined("save", true, true);
+    ok(&mut server, "set_cell", json!({"cell": "A1", "input": "42"}));
+    let inside = base.join("out/book.xlsx");
+    ok(&mut server, "save_workbook", json!({"path": s(&inside)}));
+    assert!(inside.is_file());
+
+    for (path, why) in [
+        (base.join("outside/book.xlsx"), "outside the write root"),
+        (base.join("in/book.xlsx"), "outside the write root"),
+        (base.join("out2/book.xlsx"), "outside the write root"),
+    ] {
+        refused(&mut server, "save_workbook", json!({"path": s(&path)}), why);
+        assert!(!path.exists(), "nothing written at {}", path.display());
+    }
+    let pdf = base.join("outside/book.pdf");
+    let (error, text) = run(&mut server, "file.exportPdf", json!({"path": s(&pdf)}));
+    assert!(error && text.contains("outside the write root") && !pdf.exists(), "{text}");
+    let _ = std::fs::remove_dir_all(base);
+}
+
+#[test]
+fn a_root_left_out_grants_nothing_of_its_kind() {
+    let (mut server, base) = confined("read-only", true, false);
+    ok(&mut server, "open_workbook", json!({"path": s(&base.join("in/people.csv"))}));
+    let out = base.join("out/book.xlsx");
+    refused(&mut server, "save_workbook", json!({"path": s(&out)}), "write authority is absent");
+    assert!(!out.exists());
+
+    let (mut server, base) = confined("write-only", false, true);
+    refused(&mut server, "open_workbook", json!({"path": s(&base.join("in/people.csv"))}), "read authority is absent");
+    ok(&mut server, "save_workbook", json!({"path": s(&base.join("out/book.xlsx"))}));
+    let _ = std::fs::remove_dir_all(base);
+}
