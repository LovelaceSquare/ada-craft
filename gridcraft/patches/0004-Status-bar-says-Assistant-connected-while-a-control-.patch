+/// While the control server counts an authorised connection, the status bar says an assistant is
+/// connected and `ui.inspect` reports the count; both stop when it closes.
+#[test]
+fn the_status_bar_shows_a_connected_assistant() {
+    let a = app();
+    let clients = a.control_clients.clone();
+    let mut h = harness(a);
+    h.run_steps(2);
+    assert!(h.query_by_label("Assistant connected").is_none(), "nobody connected");
+    clients.store(1, Ordering::Relaxed);
+    h.run_steps(2);
+    assert!(h.state().assistant_connected());
+    assert!(h.query_by_label("Assistant connected").is_some());
+    let ctx = h.ctx.clone();
+    let gridcraft_ui_egui::control::Outcome::Done(r) = gridcraft_ui_egui::control::handle(h.state_mut(), &ctx, "ui.inspect", &json!({})) else {
+        panic!("ui.inspect answers at once");
+    };
+    assert_eq!(r["result"]["controlClients"], 1, "{r}");
+    clients.store(0, Ordering::Relaxed);
+    h.run_steps(2);
+    assert!(h.query_by_label("Assistant connected").is_none(), "gone when the connection closes");
+}
