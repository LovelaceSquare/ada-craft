+//! File ▸ Options ▸ Agents ▸ Let assistants connect: a setting kept in `ui.json`, off by
+//! default, read and set through `ui.allowAssistants`, and a checkbox in the Backstage options.
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use egui_kittest::kittest::Queryable;
+use gridcraft_engine::Session;
+use gridcraft_ui_egui::{SheetApp, UiState};
+use serde_json::json;
+
+fn app() -> SheetApp {
+    let mut session = Session::new();
+    session.new_workbook();
+    SheetApp::new(session, Default::default())
+}
+
+fn harness(app: SheetApp) -> egui_kittest::Harness<'static, SheetApp> {
+    egui_kittest::Harness::builder().with_size(egui::vec2(1400.0, 900.0)).build_ui_state(
+        |ui, app: &mut SheetApp| {
+            app.logic(ui.ctx());
+            app.ui(ui);
+        },
+        app,
+    )
+}
+
+#[test]
+fn allow_assistants_is_a_ui_command_kept_in_ui_json_and_off_by_default() {
+    let mut a = app();
+    assert_eq!(a.run("ui.allowAssistants", json!({})), Ok(json!({"on": false})), "off by default; no value reads it");
+    assert_eq!(a.run("ui.allowAssistants", json!({})), Ok(json!({"on": false})), "reading never toggles it");
+    assert_eq!(a.run("ui.allowAssistants", json!({"on": true})), Ok(json!({"on": true})));
+    assert_eq!(a.run("ui.allowAssistants", json!({"value": false})), Ok(json!({"on": false})), "`value` is an alias");
+    a.run("ui.allowAssistants", json!({"on": true})).unwrap();
+    for junk in [json!({"on": "yes"}), json!({"on": 1}), json!({"on": null}), json!({"value": [true]})] {
+        assert!(a.run("ui.allowAssistants", junk.clone()).is_err(), "{junk}");
+    }
+    assert!(a.ui.allow_assistants, "a rejected value keeps the setting");
+    let saved = serde_json::to_string(&a.ui).unwrap();
+    assert!(saved.contains(r#""allowAssistants":true"#), "{saved}");
+    let back: UiState = serde_json::from_str(&saved).unwrap();
+    assert!(back.allow_assistants);
+    // Settings saved before the option existed, or holding junk for it, leave it off and keep the rest.
+    for old in [r#"{"dark": true}"#, r#"{"dark": true, "allowAssistants": "yes"}"#, r#"{"dark": true, "allowAssistants": null}"#] {
+        let ui: UiState = serde_json::from_str(old).unwrap();
+        assert!(!ui.allow_assistants && ui.dark, "{old}");
+    }
+}
+
+#[test]
+fn the_options_page_has_the_checkbox() {
+    let mut a = app();
+    a.run("ui.backstage", json!({"page": "options"})).unwrap();
+    let mut h = harness(a);
+    h.run_steps(4);
+    assert!(!h.state().ui.allow_assistants, "off at first");
+    h.get_by_label("Let assistants connect to this window").click();
+    h.run_steps(4);
+    assert!(h.state().ui.allow_assistants, "the checkbox turns it on");
+    h.get_by_label("Let assistants connect to this window").click();
+    h.run_steps(4);
+    assert!(!h.state().ui.allow_assistants, "and off again");
+}
